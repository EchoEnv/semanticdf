<?xml version="1.0" encoding="UTF-8"?>
<!--
  semanticdf-hera — Hera platform adapter for the semanticdf library.

  This module adapts the Hera data platform (a comprehensive
  enterprise data platform exposing 213 REST endpoints across
  DatasourceProfile / Query / TableManage / RealmManage / JobManage /
  SparkJobManage / etc.) to the engine-portable contracts in
  semanticdf-core.

  ==What this module does==

  Implements the THREE engine-portable ports that map cleanly to
  Hera's REST API:

    1. `HeraEngine extends Engine[Any]`        → /private/explore/query,
                                                /private/explore/describe/table,
                                                /private/sparkjobmanage/job/register
    2. `HeraSourceResolver extends SourceResolver`  → /private/explore/describe/table
    3. `HeraCatalogAdapter extends CatalogAdapter`  → /private/table/manage/*
                                                   + /private/realm/list

  Plus an OAuth2 auth boundary trait (`HeraAuth`) with refresh
  token support (Hera uses OAuth2 with refresh tokens, similar to
  GitHub / GCP APIs).

  ==Why a separate module==

  Per the design doc §4.6 ("catalog/engine layer separation"), a
  data-platform adapter is its own module so that engine adapters
  can depend on it cheaply without taking on the platform's
  transport dependencies.

  ==Hera authentication model (per docs/api/authentication.md)==

    POST /auth/login { user: { username, password }, tenantId }
      → { oauth: { access_token, refresh_token, expires_in, ... },
          oauthUser: { ..., realms: [...], permissions: [...] } }

  Subsequent requests carry `Authorization: <access_token>`.
  Refresh via POST /auth/refresh_token when expired.

  ==CAS mechanism (per TableManage API)==

  Hera tables carry an `optLock` field that increments on each
  update. We use `optLock` as the `semanticdf_version` slot in
  the same engine-portable CAS pattern as the UC and HMS adapters
  (PRs #424 / #423).

  ==What this module does NOT do==

  - No Spark / Trino / DuckDB / JDBC driver dependency. Pure REST.
  - No MCP registry integration (consuming engines do that).
  - No real Hera instance for integration testing (per user
    constraint: "not yet need to provision"). Tests use
    `FakeHeraClient`.

  ==Boundary contract==

  This module's `pom.xml` has zero `org.apache.spark.*` deps.
  Verifiable by:
  `grep -r 'org.apache.spark' adapters/semanticdf-hera/src/main/scala/`
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.semanticdf</groupId>
    <artifactId>semanticdf-parent</artifactId>
    <version>0.3.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>semanticdf-hera_${scala.binary.version}</artifactId>
  <packaging>jar</packaging>

  <dependencies>
    <!-- Engine-portable ADTs (Engine, SourceResolver, CatalogAdapter, ...) -->
    <dependency>
      <groupId>io.semanticdf</groupId>
      <artifactId>semanticdf-core_${scala.binary.version}</artifactId>
      <version>${project.parent.version}</version>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>