<?xml version="1.0" encoding="UTF-8"?>
<!--
  semanticdf-hive-metastore — Hive Metastore catalog adapter for
  the semanticdf library.

  The SECOND catalog adapter per the multi-engine design's §4.6.
  This one uses the Thrift transport (Unity Catalog uses REST),
  proving the §4.6 abstraction is truly transport-agnostic.

  ==Why this module exists==

  Per the design doc §4.6.1 ("Catalog layer"): the catalog
  contract is independent of any specific catalog service.
  This adapter ships a `SourceResolver` impl for Hive Metastore
  — the most-deployed catalog in the Hadoop/Spark ecosystem.

  ==Why Thrift (not REST like Unity Catalog)==

  HMS exposes a Thrift RPC API on port 9083. It's a binary
  protocol — different from UC's HTTP REST. Adding HMS proves
  the `SourceResolver` abstraction works across transports:
    - REST: Unity Catalog (PR #394)
    - Thrift: Hive Metastore  (this PR)
    - Future: JDBC (Glue), etc.

  ==Why embedded HMS (not Docker)==

  Per user constraint "easy local setup, monitor memory, disk":
    - `org.apache.hive:hive-metastore:3.1.3` includes an embedded
      mode via `EmbeddedMetaStoreClient` that starts the Thrift
      server in the same JVM. No Docker, no separate container.
    - Derby-backed storage = bounded disk (file-based).
    - Real HMS Thrift protocol = proves §4.6 transport-agnostic
      claim against the actual HMS binary protocol.
    - Sub-second startup vs. 4+ min Docker startup.

  For production deployments, the same adapter works against a
  real remote HMS (just point `ThriftHiveMetastoreClient` at the
  remote Thrift endpoint). The trait + tests cover both paths.

  ==What this module does==

  - `HiveMetastoreClient` trait (boundary for testability)
  - `ThriftHiveMetastoreClient` impl (real HMS Thrift)
  - `EmbeddedHiveMetastoreClient` impl (in-process HMS — for tests
    and local dev)
  - `HiveMetastoreSourceResolver` (SourceResolver impl)
  - `FakeHiveMetastoreClient` (test fixture)
  - Integration test against real embedded HMS

  ==What this module does NOT do==

  - No Spark / Trino / DuckDB deps.
  - No engine-portable type definitions (those live in core).
  - No HTTP / REST (we use the binary Thrift protocol).
  - No HMS write operations (DDL/DML). SourceResolver is read-only.

  ==Boundary contract==

  Zero Spark imports. Verifiable by:
  `grep -r 'org.apache.spark' adapters/semanticdf-hive-metastore/`

  ==Library version==

  0.2.4 — same as parent, core, spark, trino, unity-catalog, duckdb.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.semanticdf</groupId>
    <artifactId>semanticdf-parent</artifactId>
    <version>0.2.4</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>semanticdf-hive-metastore_2.13</artifactId>
  <packaging>jar</packaging>

  <name>semanticdf-hive-metastore</name>
  <description>
    Hive Metastore catalog adapter for the semanticdf library.
    The second catalog adapter per the multi-engine design's
    §4.6 — Thrift transport (vs. Unity Catalog's REST), proving
    the abstraction is transport-agnostic.
  </description>

  <dependencies>
    <!-- Engine-portable ADTs (SourceResolver, ResolvedSource, etc.) -->
    <dependency>
      <groupId>io.semanticdf</groupId>
      <artifactId>semanticdf-core_2.13</artifactId>
      <version>${project.parent.version}</version>
    </dependency>

    <!-- Hive Metastore client + server (Thrift + Derby).
         Version 3.1.3 matches Spark 3.5.x's bundled HMS.
         Includes:
           - org.apache.hadoop.hive.metastore.HiveMetaStoreClient
             (Thrift client for remote/local HMS)
           - org.apache.hadoop.hive.metastore.EmbeddedMetaStoreClient
             (in-process HMS server for tests + local dev)
           - Derby-backed storage (file-based) -->
    <dependency>
      <groupId>org.apache.hive</groupId>
      <artifactId>hive-metastore</artifactId>
      <version>3.1.3</version>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.scalatest</groupId>
      <artifactId>scalatest_${scala.binary.version}</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>net.alchim31.maven</groupId>
        <artifactId>scala-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>