# Maven / Scala build output
target/
build/

# Scala / IDE artifacts
*.class
*.jar
*.war

# IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Metals / BSP / VSCode (Scala tooling)
.metals/
.bloop/
.bsp/
.vscode/

# OS noise
.DS_Store

# Per-developer AI / agent configuration (Claude Code skills, agent
# workflow settings, etc.) — local to each developer. The symlink
# `.claude/skills/karpathy-guidelines` resolves into `.agents/`; ignore both
# so neither is ever re-committed by accident.
.agents/
.claude/

# Claude Code skills lockfile — pins installed skill versions locally; not
# source-of-truth for the repo. Regenerated by each developer's Claude
# install; must never be committed.
skills-lock.json
TEST-*.xml

# Team onboarding guide generated by Claude Code's `/team-onboarding`
# skill. Local artifact — regenerate per teammate, never commit.
ONBOARDING.md

# DuckDB shared-cache file from `buildDuckDBEngineOptional`
# (PlatformApplication.java:1089) — DuckDB materializes the shared cache
# to the CWD with the literal connection-string parameters as its filename.
# Runtime artifact; never commit.
?cache=*
