<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      semanticdf-platform — P1 of the standalone semantic data platform.
      See docs/design/platform-architecture.md for the design.

      This is a separate Maven project (not a module of the parent
      semanticdf). It depends on the semanticdf library as a Maven
      dependency. The Restate SDK is used for durable async/await.
    -->

    <groupId>io.semanticdf</groupId>
    <artifactId>semanticdf-platform_2.13</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>semanticdf-platform</name>
    <description>Standalone semantic data platform — Restate-native runtime. P1 of the
    platform-architecture design (docs/design/platform-architecture.md). Exposes 5
    Restate services (ModelService, QueryService, StreamingService, AuditService,
    CatalogService) and a REST surface for agents/BI tools.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java 21 — the platform layer (per the platform-architecture design) -->
        <maven.compiler.release>17</maven.compiler.release>

        <!--
          We compile to Scala 2.13 to match the semanticdf library's bytecode
          (so we can call into it from Java without FFI friction). The platform
          itself is Java; we only need the 2.13 bytecode for the JAR dep on
          semanticdf.
        -->
        <scala.binary.version>2.13</scala.binary.version>

        <!-- Restate SDK version (matches the local SDK at /tmp/sdk-java). -->
        <restate.sdk.version>2.8.0</restate.sdk.version>

        <!--
          Postgres + HikariCP for StreamCatalog (DE-H2 from PR #232
          senior review).
        -->
        <postgres.version>42.7.4</postgres.version>
        <hikari.version>5.1.0</hikari.version>

        <!-- semanticdf library version — the platform calls into it. -->
        <semanticdf.version>0.2.3</semanticdf.version>

        <slf4j.version>2.0.16</slf4j.version>
        <jackson.version>2.15.2</jackson.version>

        <!-- Spark is `provided` — the platform is engine-agnostic; the user's
             runtime brings Spark when they consume a query. -->
        <spark.version>3.5.8</spark.version>

        <!-- add-opens flags for Spark 3.5.x on JDK 17. Single source of truth:
             referenced by surefire's argLine below. The same flag set is
             shipped in .mvn/jvm.config (read by Maven at JVM startup, NOT
             reachable from this property because Maven reads jvm.config
             before properties are resolved) and a CI test should assert
             the two stay in sync. See ../.mvn/jvm.config for the literal
             flag values; XML 1.0 paragraph 2.5 forbids the two-dash
             sequence inside comments, so the literal flag prefix is not
             reproduced here. -->
        <add.opens.flags>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/sun.util.calendar=ALL-UNNAMED</add.opens.flags>
    </properties>

    <dependencies>
        <!-- semanticdf Scala library — used by the platform for model
             compilation, lineage, and query execution. Installed locally
             via `mvn install`. See docs/design/platform-architecture.md
             for the runtime boundary. -->
        <dependency>
            <groupId>io.semanticdf</groupId>
            <artifactId>semanticdf_2.13</artifactId>
            <version>${semanticdf.version}</version>
        </dependency>

        <!--
          Restate SDK — durable async/await runtime.

          Cross-service calls (e.g. StreamingService.run → AuditService.append)
          use the in-handler API Restate.virtualObject(...) / Restate.service(...),
          which lives in sdk-api (transitive from sdk-java-http). No separate
          client module is needed — the proxy is created at runtime via
          bytebuddy (a runtimeOnly transitive dep of sdk-api).
        -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-java-http</artifactId>
            <version>${restate.sdk.version}</version>
        </dependency>

        <!-- JSON serialization for the platform's REST surface. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-scala_2.13</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!--
          Postgres driver + connection pool.

          Used by StreamCatalog (bulk startup reconciliation, DE-H2
          from PR #232 senior review) for the durable stream-id list.
          We share the Postgres instance that Restate uses for its
          journal — they're under different schemas, no conflict.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgres.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikari.version}</version>
        </dependency>

        <!-- Logging — minimal; the platform emits structured JSON to stdout. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.20.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Spark is `provided`; the engine adapter (future) brings it. -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <version>${spark.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Restate admin client — provides dev.restate.sdk.client.Client for the
             smoke test that drives the platform's services from a test process. -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>admin-client</artifactId>
            <version>${restate.sdk.version}</version>
        </dependency>

        <!-- Test scope. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <!--
          log4j-core (test scope) — needed by the SparkSession initialiser
          when `SparkSession.builder().getOrCreate()` runs inside an
          end-to-end integration test. The runtime-scope log4j-slf4j2-impl
          alone provides only the slf4j bridge; Spark's
          `internal.config.package.<clinit>` resolves the core Logger
          on first reference, which fails if log4j-core is missing.
        -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.20.0</version>
            <scope>test</scope>
        </dependency>

        <!--
          Restate sdk-testing — boots a real Restate runtime via Testcontainers
          for end-to-end integration tests of the Workflow lifecycle (start,
          monitor loop, stop). Required to validate the @Shared + STOP_SIGNAL
          concurrency contract that unit tests cannot prove.
        -->
        <dependency>
            <groupId>dev.restate</groupId>
            <artifactId>sdk-testing</artifactId>
            <version>${restate.sdk.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Local mode: bundle Spark into the runtime classpath so the
             platform can run via `mvn exec:java`. Default (no profile)
             keeps Spark as `provided` for slim production JARs. -->
        <profile>
            <id>local</id>
            <dependencies>
                <!-- spark-streaming (legacy DStream API) intentionally omitted:
                     the codebase uses org.apache.spark.sql.streaming.* (Structured
                     Streaming) only. The DStream module pulls its own netty/akka
                     transitive tree that nobody reads. -->
                <dependency>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>spark-sql_${scala.binary.version}</artifactId>
                    <version>${spark.version}</version>
                    <scope>compile</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>spark-core_${scala.binary.version}</artifactId>
                    <version>${spark.version}</version>
                    <scope>compile</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.spark</groupId>
                    <artifactId>spark-catalyst_${scala.binary.version}</artifactId>
                    <version>${spark.version}</version>
                    <scope>compile</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                    <version>2.20.0</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!-- exec-maven-plugin pinned unconditionally so `mvn exec:java`
                 always uses the same version, whether or not -Plocal is on. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>${add.opens.flags}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
