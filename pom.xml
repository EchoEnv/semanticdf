<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.semanticdf</groupId>
  <artifactId>semanticdf-parent</artifactId>
  <version>0.3.0</version>
  <packaging>pom</packaging>

  <name>semanticdf-parent</name>
  <description>
    Parent POM for the semanticdf multi-module build. Aggregates:
      - semanticdf-core (engine-portable ADTs, no Spark deps)
      - adapters/semanticdf-spark (Spark engine adapter — the library)
      - adapters/semanticdf-trino (Phase 2: Trino engine adapter)
  </description>

  <modules>
    <module>semanticdf-core</module>
    <module>adapters/semanticdf-spark</module>
    <module>adapters/semanticdf-trino</module>
    <module>adapters/semanticdf-unity-catalog</module>
    <module>adapters/semanticdf-duckdb</module>
    <module>adapters/semanticdf-hive-metastore</module>
    <module>adapters/semanticdf-hera</module>
    <module>adapters/semanticdf-template</module>
    <module>adapters/semanticdf-portable-loader</module>
    <module>adapters/semanticdf-postgresql</module>
    <module>semanticdf-cli</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Scala: 2.13 only (ADR 0001). Spark 4 is 2.13-only, so 2.13 covers both Spark lines. -->
    <scala.version>2.13.18</scala.version>
    <scala.binary.version>2.13</scala.binary.version>

    <!-- Spark: 3.5.8 is the default/primary target (DESIGN §7). -->
    <spark.version>3.5.8</spark.version>

    <scalatest.version>3.2.19</scalatest.version>

    <!-- Java 17: the intersection satisfying Spark 3.5.x (8/11/17) and Spark 4 (17+). -->
    <maven.compiler.release>17</maven.compiler.release>

    <scala.maven.plugin.version>4.9.2</scala.maven.plugin.version>
    <scalatest.maven.plugin.version>2.2.0</scalatest.maven.plugin.version>

    <!-- Library version (semanticdf-spark_2.13): consumed by the platform
         module as a Maven dep. Bump on library release. -->
    <semanticdf.version>0.2.4</semanticdf.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>

    <!-- Spark needs reflective access to internal JDK modules (sun.nio.ch.DirectBuffer, etc.),
         which Java 17 locks down. These flags open them for the FORKED TEST JVM only.
         They mirror what spark-submit sets; without them, SparkContext init fails on JDK 17+. -->
    <spark.test.argLine>--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.invoke=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.net=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/java.util.concurrent=ALL-UNNAMED --add-opens=java.base/java.util.concurrent.atomic=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/sun.nio.cs=ALL-UNNAMED --add-opens=java.base/sun.security.action=ALL-UNNAMED --add-opens=java.base/sun.util.calendar=ALL-UNNAMED</spark.test.argLine>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The library modules depend on each other and on Spark. Pin here
           so each module's pom is short and consistent. -->
      <dependency>
        <groupId>io.semanticdf</groupId>
        <artifactId>semanticdf-core_2.13</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.semanticdf</groupId>
        <artifactId>semanticdf-spark_2.13</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-sql_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-catalyst_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-core_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.scala-lang</groupId>
        <artifactId>scala-library</artifactId>
        <version>${scala.version}</version>
      </dependency>
      <dependency>
        <groupId>org.scalatest</groupId>
        <artifactId>scalatest_${scala.binary.version}</artifactId>
        <version>${scalatest.version}</version>
      </dependency>
      <dependency>
        <groupId>org.yaml</groupId>
        <artifactId>snakeyaml</artifactId>
        <version>1.33</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.15.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.module</groupId>
        <artifactId>jackson-module-scala_2.13</artifactId>
        <version>2.15.2</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>1.5.2</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- No <dependencies> block: this is a pom-packaging parent. Child
       modules declare their own deps and inherit only the
       dependencyManagement above for version pinning. -->

  <build>
    <pluginManagement>
      <plugins>
        <!-- Same plugins as before, but in <pluginManagement> so they're
             version-pinned and inherited by children, NOT executed on the
             parent itself. Children opt-in by declaring them in their
             own <build><plugins>. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>

        <plugin>
          <groupId>net.alchim31.maven</groupId>
          <artifactId>scala-maven-plugin</artifactId>
          <version>${scala.maven.plugin.version}</version>
          <configuration>
            <scalaVersion>${scala.version}</scalaVersion>
            <args>
              <arg>-deprecation</arg>
              <arg>-feature</arg>
              <arg>-unchecked</arg>
            </args>
          </configuration>
          <executions>
            <execution>
              <id>scala-compile</id>
              <phase>process-resources</phase>
              <goals>
                <goal>add-source</goal>
                <goal>compile</goal>
              </goals>
            </execution>
            <execution>
              <id>scala-test-compile</id>
              <phase>process-test-resources</phase>
              <goals>
                <goal>testCompile</goal>
              </goals>
            </execution>
            <execution>
              <id>scala-doc-jar</id>
              <phase>package</phase>
              <goals>
                <goal>doc-jar</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
          <configuration>
            <mainClass>io.semanticdf.tools.Main</mainClass>
            <!-- Use compile classpath so target/classes (Scala-compiled output) is included. -->
            <classpathScope>compile</classpathScope>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.scalatest</groupId>
          <artifactId>scalatest-maven-plugin</artifactId>
          <version>${scalatest.maven.plugin.version}</version>
          <configuration>
            <argLine>${spark.test.argLine}</argLine>
            <suffixes>Spec</suffixes>
            <reportsDirectory>${project.build.directory}/surefire-reports</reportsDirectory>
            <junitxml>.</junitxml>
            <filereports>semanticdf-test-suite.txt</filereports>
          </configuration>
          <executions>
            <execution>
              <id>test</id>
              <goals>
                <goal>test</goal>
              </goals>
            </execution>
          </executions>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.3.1</version>
          <executions>
            <execution>
              <id>attach-sources</id>
              <phase>verify</phase>
              <goals>
                <goal>jar-no-fork</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Spark 4.x leg (DESIGN §7, ADR 0002). Verified green: 3.5.8 (default), 4.0.0, 4.1.1.
       Activate: mvn -Pspark4 test. No code shims needed — uses only APIs stable across 3.5→4.x. -->
  <profiles>
    <profile>
      <id>spark4</id>
      <properties>
        <spark.version>4.1.1</spark.version>
        <!-- Bump scala.version here if a future Spark 4 release pins a newer 2.13.x. -->
      </properties>
    </profile>
  </profiles>
</project>
